# Backend Environment Variables
# -----------------------------
# Port is automatically provided by Render ($PORT). Defaults to 8000 locally.
# PORT=8000
# HOST=0.0.0.0

# Optional: Restrict allowed CORS origins in production (comma-separated):
# If unset, allows all origins for ease of deployment.
# CORS_ORIGINS=https://sql-chat-frontend.onrender.com,http://localhost:5173

# Optional: Custom database path (e.g., if using a persistent disk mount on Render):
# DATABASE_PATH=/var/data/ecommerce.db
